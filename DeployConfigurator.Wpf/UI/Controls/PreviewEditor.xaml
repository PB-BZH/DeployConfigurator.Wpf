<UserControl x:Class="DeployConfigurator.Wpf.UI.Controls.PreviewEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!-- ======================================================
             NUMÉROS DE LIGNES
             ====================================================== -->

        <Border Grid.Column="0"
                Background="{Binding Background, ElementName=rtbEditor}">

            <ScrollViewer x:Name="lineNumbersScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          IsHitTestVisible="False">

                <TextBlock x:Name="txtLineNumbers"
                           FontFamily="Consolas"
                           FontSize="13"
                           LineHeight="18"
                           TextAlignment="Right"
                           Padding="0,4,7,0"
                           Foreground="{Binding Foreground, ElementName=rtbEditor}"
                           Opacity="0.55" />

            </ScrollViewer>

        </Border>


        <!-- ======================================================
             SÉPARATEUR
             ====================================================== -->

        <Border Grid.Column="1"
                Background="{Binding BorderBrush, ElementName=rtbEditor}" />


        <!-- ======================================================
             ÉDITEUR
             ====================================================== -->

        <RichTextBox x:Name="rtbEditor"
                     Grid.Column="2"
                     FontFamily="Consolas"
                     FontSize="13"
                     BorderThickness="0"
                     AcceptsTab="True"
                     IsReadOnly="True"
                     IsInactiveSelectionHighlightEnabled="True"
                     Cursor="IBeam"
                     Padding="4"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextChanged="rtbEditor_TextChanged"
                     Loaded="rtbEditor_Loaded"
                     MouseDoubleClick="rtbEditor_MouseDoubleClick">


            <!-- ==============================================
                 MENU CONTEXTUEL
                 ============================================== -->

            <RichTextBox.ContextMenu>

                <ContextMenu>

                    <MenuItem Header="Copy"
                              Click="Copy_Click" />

                    <MenuItem Header="Select all"
                              Click="SelectAll_Click" />

                    <Separator />

                    <MenuItem Header="Open in Notepad++"
                              Click="OpenNotepadPlusPlus_Click" />

                </ContextMenu>

            </RichTextBox.ContextMenu>


            <!-- ==============================================
                 DOCUMENT
                 ============================================== -->

            <FlowDocument PagePadding="0"
                          PageWidth="10000">

                <Paragraph Margin="0"
                           LineHeight="18"
                           LineStackingStrategy="BlockLineHeight" />

            </FlowDocument>

        </RichTextBox>

    </Grid>

</UserControl>